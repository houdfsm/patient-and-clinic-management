#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// structure de patient
typedef struct patient {
    int ID;
    char nom[50];
    char prenom[50];
    char datenaissance[11];
    char telephone[15];
    struct patient* next;
} patient, *Listepatients;

// structure de Rdv
typedef struct rendez_vous {
    int num_rdv;
    int num_patient;
    char date[15];   
    char heure[10];  
    char motif[100];
    struct rendez_vous* suiv;
} rendez_vous, *ListeRDV;

